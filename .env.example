# HTTP port the backend listens on
HTTP_PORT=8111

# Approov secret: approov secret -get base64url
APPROOV_BASE64URL_SECRET=approov_base64url_secret_here

# Optional: Approov account message signing secret (use one of these formats)
APPROOV_ACCOUNT_MESSAGE_SIGNING_SECRET_BASE64URL=
APPROOV_ACCOUNT_MESSAGE_SIGNING_SECRET_BASE64=
APPROOV_ACCOUNT_MESSAGE_SIGNING_SECRET_RAW=
# Optional: expected message signing key id (mskid claim)
APPROOV_ACCOUNT_MESSAGE_SIGNING_KEY_ID=

# Optional: allowed clock skew for message signing timestamps (seconds)
APPROOV_MESSAGE_SIGNING_TOLERANCE_SECONDS=60

# Verbose logging for Approov + message signing flow
APPROOV_VERBOSE_LOGGING=true

# Log full HTTP request/response payloads
APPROOV_HTTP_LOGGING=false

# Localhost
SERVER_HOSTNAME=0.0.0.0

# Command that starts your server inside the container
APP_START_CMD=npm start
